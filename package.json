{
  "name": "happychair-tableside",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "HC_REQUIRE_STAGING=1 vite --host",
    "build:staging": "HC_REQUIRE_STAGING=1 vite build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node tests/no-simulated-progress.test.mjs && node tests/request-status.test.mjs && node --test tests/staging-env.test.ts",
    "test:harness": "node tests/harness/run.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@supabase/supabase-js": "^2.49.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
